{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "app": "tsx tools/app-control/cli.ts",
    "assets:generate": "tsx tools/assets/cli.ts generate",
    "assets:check": "tsx tools/assets/cli.ts check",
    "assets:audit": "tsx tools/assets/cli.ts audit",
    "theme:audit": "tsx tools/theme/colorAudit.ts --paths src",
    "preflight": "tsx tools/preflight/cli.ts fast",
    "preflight:release": "tsx tools/preflight/cli.ts release",
    "preflight:eas": "tsx tools/preflight/cli.ts eas --json .preflight/eas-report.json",
    "eas-build-post-install": "npm run preflight:eas",
    "start": "expo start -c",
    "start-no-clear": "expo start",
    "android": "expo run:android",
    "android:sync-native": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-sync-native.ps1",
    "android:apk:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-local-build.ps1",
    "android:install:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-local-install.ps1",
    "ios": "expo run:ios",
    "web": "expo start -c --web",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:android:dev": "npm run app -- build android --profile development --yes",
    "build:android:preview": "npm run app -- build android --profile preview --yes",
    "build:android:prod": "npm run app -- build android --profile production --yes",
    "build:ios:dev": "npm run app -- build ios --profile development --yes",
    "build:ios:preview": "npm run app -- build ios --profile preview --yes",
    "build:ios:prod": "npm run app -- build ios --profile production --yes",
    "update:prod": "eas update --branch production --environment production --message",
    "update:preview": "eas update --branch preview --environment preview --message"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-navigation/material-bottom-tabs",
          "moment",
          "moment-timezone",
          "react-native-web-webview",
          "@shopify/react-native-skia"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "6.x",
    "@react-navigation/drawer": "^6.6.15",
    "@react-navigation/material-bottom-tabs": "^6.2.28",
    "@react-navigation/material-top-tabs": "^6.6.13",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@shopify/react-native-skia": "^2.1.1",
    "@tanstack/query-async-storage-persister": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-persist-client": "^5.0.0",
    "axios": "^1.7.2",
    "expo": "~53.0.27",
    "expo-background-task": "~0.2.8",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-health-connect": "^0.1.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.18",
    "getenv": "2.0.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-blob-util": "^0.24.6",
    "react-native-calendars": "^1.1305.0",
    "react-native-circular-progress": "^1.4.1",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.3.0",
    "react-native-infinite-wheel-picker": "^1.0.0",
    "react-native-keyboard-controller": "^1.19.6",
    "react-native-pager-view": "6.7.1",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.11.2",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-tab-view": "^3.5.2",
    "react-native-web": "^0.20.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.13.5",
    "react-native-youtube-iframe": "^2.3.0",
    "victory-native": "^41.19.3",
    "zod": "^3.25.76",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@clack/prompts": "1.7.0",
    "@expo/config": "~11.0.13",
    "@types/react": "~19.0.10",
    "dotenv-cli": "^7.4.4",
    "fast-glob": "3.3.3",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "~5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@shopify/react-native-skia": "^2.1.1",
    "@expo/config-plugins": "~10.1.1"
  },
  "private": true
}
