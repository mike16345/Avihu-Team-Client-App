<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/live_steps_card_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="14dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|baseline">

            <TextView
                android:id="@+id/stepsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#80072723"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="צעדים שנעשו:"
                xmlns:tools="http://schemas.android.com/tools"/>

            <TextView
                android:id="@+id/stepsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A1D24"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="8,500"
                xmlns:tools="http://schemas.android.com/tools"/>

            <TextView
                android:id="@+id/stepsGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80072723"
                android:textSize="13sp"
                tools:text=" / מתוך 12,000"
                xmlns:tools="http://schemas.android.com/tools"/>
        </LinearLayout>

        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#80072723"
            android:textSize="13sp"
            tools:text="מרחק קילומטר: 6.5"
            xmlns:tools="http://schemas.android.com/tools"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <ProgressBar
            android:id="@+id/ringProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progressDrawable="@drawable/live_steps_ring"
            android:max="100"/>

        <TextView
            android:id="@+id/percentText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#1A1D24"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="71%"
            xmlns:tools="http://schemas.android.com/tools"/>
    </FrameLayout>
</LinearLayout>
