<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/live_steps_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="44dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="16dp">

            <ProgressBar
                android:id="@+id/ringProgressExpanded"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/live_steps_ring" />

            <TextView
                android:id="@+id/percentTextExpanded"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#1A1D24"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="29%" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/expandedSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1A1D24"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="3,540 / מתוך 12,000 צעדים שנעשו" />

            <TextView
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#6E837C"
                android:textSize="15sp"
                tools:text="מרחק קילומטר: 2.7" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/logoBadgeExpanded"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/live_steps_logo_badge_bg"
        android:elevation="4dp"
        android:padding="3dp"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />
</FrameLayout>
